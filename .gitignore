/toolchains/
/.venv/
/nuttx/arch/xtensa/src/esp32s3/esp-hal-3rdparty/

# Objetos, bibliotecas e registros de compilacao
*.o
*.a
.depend
.depend.*
.context
.dirlinks
.built
.kconfig
Make.dep
Make.dep.*
/apps/libapps.a.lock
/nuttx/**/*.ld.tmp

# Firmware, mapas e bibliotecas em staging
/nuttx/nuttx
/nuttx/nuttx.bin
/nuttx/nuttx.hex
/nuttx/nuttx.elf
/nuttx/nuttx.uf2
/nuttx/nuttx.map
/nuttx/nuttx.manifest
/nuttx/System.map
/nuttx/staging/
/apps/staging/

# Configuracao local e cabecalhos gerados; configs/ permanece versionado
/nuttx/.config
/nuttx/.config.*
/nuttx/.config-*
/nuttx/defconfig
/nuttx/defconfig.tmp
/nuttx/defconfig.tmp.*
/nuttx/include/nuttx/config.h
/nuttx/include/nuttx/version.h

# Executaveis de ferramentas gerados no computador
/nuttx/tools/incdir
/nuttx/tools/mkconfig
/nuttx/tools/mkversion
/nuttx/tools/mkdeps
/nuttx/tools/cnvwindeps

# Diretorios de objetos e ROMFS gerada para a ESP32-S3
